<?xml version="1.0" encoding="UTF-8"?>
<!--
  Права (entitlements) для App-таргета PhotoPull в Xcode.

  Пояснения:
    * app-sandbox                    — включить песочницу (требуется для распространения).
    * device.usb                     — доступ к устройству по USB (импорт с iPhone кабелем).
    * network.client                 — обнаружение сетевых (Bonjour) устройств.
    * files.user-selected.read-write — запись в выбранную пользователем папку назначения.

  Примечание: доступ к подключённому устройству дополнительно подтверждается пользователем
  через системный запрос конфиденциальности при первом подключении.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.usb</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
